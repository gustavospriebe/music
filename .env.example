# Configuração canônica — nunca grave secrets reais neste arquivo.
# Local: copie para .env somente se ele ainda não existir; faça backup antes de editar.
# Preview isolado sem chaves: bash scripts/local-preview.sh api|web|worker.
# Railway: use serviços chamados `web`, `api`, `worker`, `Postgres` e `Bucket` para
# aproveitar as referências abaixo. Adicione somente as variáveis usadas por cada serviço.
# Guia completo: docs/railway-setup.md

# Runtime e URLs
NODE_ENV=development
# Railway api: PORT é injetada pela plataforma e tem precedência sobre API_PORT.
PORT=3001
API_PORT=3001
WEB_URL=http://localhost:5175
# Railway api/worker: WEB_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
# Produção web (proxy Nginx em runtime; mesmo domínio para navegador e cookies):
# API_UPSTREAM=http://api.railway.internal:3001
# Somente proxy do Vite em desenvolvimento:
API_URL=http://localhost:3001
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://resenha:resenha@localhost:5433/resenha
# Railway api/worker: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL_TEST=postgresql://resenha:resenha@localhost:5433/resenha_test

# Secrets da aplicação — gere valores independentes com `openssl rand -hex 32`.
COOKIE_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_ACCESS_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Admin único — use seu e-mail e uma senha exclusiva forte.
ADMIN_EMAIL=admin@resenha.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_TTL=28800

# Providers: use disabled/local-log enquanto decide os fornecedores.
LYRICS_PROVIDER=openrouter
MUSIC_PROVIDER=openrouter
PAYMENT_PROVIDER=disabled
# Ambiente financeiro independente de NODE_ENV. API/worker devem usar o mesmo valor.
# sandbox usa chave Devmode real do gateway, com checkout restrito a admin + capability.
# live só depois da ativação comercial. Ausente: live em NODE_ENV=production; sandbox fora.
PAYMENT_ENVIRONMENT=sandbox
EMAIL_PROVIDER=local-log

# Comercial: nenhum preço ou política é assumido para a nova criação livre.
BRAND_NAME=Música da Resenha
# Seed inicial: centavos inteiros; 0 = ainda não definido, nunca oferta gratuita.
# Aplicar um valor inicial só atualiza custom_song que ainda estiver sem preço.
SONG_PRICE_CENTS=0
COMMERCIAL_READY=false
SUPPORT_EMAIL=
DELIVERY_ESTIMATE=
REVISION_POLICY=
REFUND_POLICY=
USAGE_LICENSE=
TERMS_URL=
PRIVACY_URL=
POLICY_VERSION=

# OpenRouter: letra, duas versões de áudio e capa opcional.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3-flash-preview
# Limite por chamada de letra, incluindo tokens de raciocínio quando cobrados como saída.
OPENROUTER_TEXT_MAX_TOKENS=8192
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview
# Modelos opcionais de capa; confirme disponibilidade/custo no provedor antes de habilitar.
OPENROUTER_COVER_TEXT_MODEL=google/gemini-3.1-flash-lite-image
OPENROUTER_COVER_REFERENCE_MODEL=google/gemini-3.1-flash-image

# Google AI Interactions / Lyria 3.5: selecione MUSIC_PROVIDER=google para áudio.
# Chave usada somente por API/worker server-side; nunca a exponha à web.
GOOGLE_API_KEY=
GOOGLE_MUSIC_MODEL=lyria-3.5

# AbacatePay Checkout hospedado: selecione PAYMENT_PROVIDER=abacatepay.
# disabled ou chave ausente fora de produção permitem somente simulação local explícita.
# A chave define o ambiente na API AbacatePay; respostas devMode divergentes são rejeitadas.
# Homologação Railway: NODE_ENV=production, PAYMENT_ENVIRONMENT=sandbox, COMMERCIAL_READY=false.
ABACATEPAY_API_KEY=
ABACATEPAY_PRODUCT_ID=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_URL=
ABACATEPAY_REQUIRE_WEBHOOK_SIGNATURE=true
# Railway api: ABACATEPAY_WEBHOOK_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/api/v1/webhooks/abacatepay
# Cadastre endpoint limpo + secret separado; AbacatePay acrescenta ?webhookSecret=<segredo>.

# Resend: selecione EMAIL_PROVIDER=resend e configure domínio verificado.
# local-log é somente dev; produção exige Resend configurado e não faz fallback.
RESEND_API_KEY=
EMAIL_FROM=Musica da Resenha <noreply@seudominio.com>
LOCAL_EMAIL_PATH=./var/emails

# Revisão e worker
# automatic_release apenas libera após validação técnica; não avalia qualidade artística.
AUDIO_REVIEW_MODE=manual
WORKER_ID=worker-railway
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=1000
JOB_LOCK_TIMEOUT_MS=300000

# Storage local — apenas desenvolvimento/teste; API e worker precisam do mesmo caminho absoluto.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/tmp/resenha-storage

# Produção usa S3 privado. No Railway, injete as mesmas referências em api e worker:
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=${{Bucket.BUCKET}}
# STORAGE_S3_REGION=${{Bucket.REGION}}
# STORAGE_S3_ENDPOINT=${{Bucket.ENDPOINT}}
# STORAGE_S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# STORAGE_S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# Buckets atuais usam virtual-hosted style; confirme a aba Credentials se o bucket for antigo.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
