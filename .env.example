# Não há modo fake. OpenRouter é obrigatório para letra/áudio; pagamento/e-mail têm fallback fora de produção.
NODE_ENV=development
WEB_URL=http://localhost:5175
# Opcional: sobrescreve o proxy do Vite em dev (ex.: API em outro host)
# VITE_API_URL=http://localhost:3001
API_URL=http://localhost:3001
API_PORT=3001
DATABASE_URL=postgresql://resenha:resenha@localhost:5433/resenha
DATABASE_URL_TEST=postgresql://resenha:resenha@localhost:5433/resenha_test
LOG_LEVEL=info
COOKIE_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_ACCESS_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# Login do admin (único usuário com acesso ao painel)
ADMIN_EMAIL=admin@resenha.local
ADMIN_PASSWORD=replace-with-a-simple-password
ADMIN_SESSION_TTL=28800
LYRICS_PROVIDER=openrouter
MUSIC_PROVIDER=openrouter
PAYMENT_PROVIDER=mercadopago
EMAIL_PROVIDER=resend
# OpenRouter: gera a letra, duas versões de áudio e a capa opcional
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_MUSIC_MODEL=
# Sem foto (~US$ 0,0336/saída 1K) e com foto (~US$ 0,067/saída 1K).
OPENROUTER_COVER_TEXT_MODEL=google/gemini-3.1-flash-lite-image
OPENROUTER_COVER_REFERENCE_MODEL=google/gemini-3.1-flash-image
# Mercado Pago (Checkout Pro): pagamento do pedido
# Em dev, sem ACCESS_TOKEN o checkout roda em modo local e há endpoint de aprovação apenas fora de produção.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública do webhook (ex.: https://seudominio/api/v1/webhooks/mercado-pago)
MERCADO_PAGO_WEBHOOK_URL=
# Resend: e-mail de entrega com link privado (opcional fora de produção; sem key, salva em var/emails)
RESEND_API_KEY=
EMAIL_FROM=Musica da Resenha <noreply@seudominio>
AUDIO_REVIEW_MODE=automatic
# Desenvolvimento/teste: local. Produção falha ao iniciar se não for s3.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./var/storage
# S3 compatível privado (produção). Endpoint/credenciais são opcionais quando o runtime fornece IAM.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
WORKER_ID=worker-local
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=1000
JOB_LOCK_TIMEOUT_MS=300000
