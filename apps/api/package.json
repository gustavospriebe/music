    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@resenha/contracts": "workspace:*",
    "@resenha/database": "workspace:*",
    "@resenha/domain": "workspace:*",
    "@resenha/providers": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.0",
