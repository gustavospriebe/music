{
  "name": "musica-da-resenha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @resenha/web dev",
    "dev:api": "pnpm --filter @resenha/api dev",
    "dev:worker": "pnpm --filter @resenha/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:unit": "turbo run test:unit --concurrency=1",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:ops": "node --test scripts/verify-object-restore.test.mjs",
    "test:e2e": "pnpm --filter @resenha/web test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:ops && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @resenha/database generate",
    "db:migrate": "pnpm --filter @resenha/database migrate",
    "db:seed": "pnpm --filter @resenha/database seed",
    "db:studio": "pnpm --filter @resenha/database studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
